# CodeCompass — Environment variable template
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real credentials.

# Google Gemini API Key (required for AI responses)
GEMINI_API_KEY=your-gemini-api-key-here

# SMTP / Email (required for email verification and password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here
MAIL_FROM=your-email@gmail.com
MAIL_DEV_FALLBACK=false

# App base URL (used in verification / reset email links)
APP_BASE_URL=http://localhost:8080

# Optional: Supabase integration (leave blank to use local H2 database)
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
